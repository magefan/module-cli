<?php
/** @var $block \Magefan\Cli\Block\Adminhtml\History */
$logs = $block->getLogs(200);
?>
<div class="admin__page-section">
    <h1><?= $block->escapeHtml(__('Command Line History')) ?></h1>
    <table class="data-grid">
        <thead>
            <tr>
                <th><?= $block->escapeHtml(__('ID')) ?></th>
                <th><?= $block->escapeHtml(__('Command')) ?></th>
                <th><?= $block->escapeHtml(__('Result')) ?></th>
                <th><?= $block->escapeHtml(__('User ID')) ?></th>
                <th><?= $block->escapeHtml(__('Executed At')) ?></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($logs as $row): ?>
            <tr>
                <td><?= (int)$row['log_id'] ?></td>
                <td><pre><?= $block->escapeHtml($row['command']) ?></pre></td>
                <td><pre><?= $block->escapeHtml($row['result']) ?></pre></td>
                <td><?= $row['user_id'] !== null ? (int)$row['user_id'] : '' ?></td>
                <td><?= $block->escapeHtml($row['executed_at']) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>
